{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CampaignRunManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "repo_git_sha", "dataset", "data_origin", "scenario_origin", "policy_id", "seed", "budget_units", "batch_size", "initial_label_ids", "initial_labels_budget_rule", "algorithm_status", "digital_twin_maturity"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "repo_git_sha": {"type": "string", "minLength": 7},
    "dataset": {"type": "object", "additionalProperties": false, "required": ["name", "release", "sha256", "assay_id", "label_semantics", "terms_status"], "properties": {"name": {"type": "string"}, "release": {"type": "string"}, "sha256": {"type": "string"}, "assay_id": {"type": "string"}, "label_semantics": {"type": "string"}, "terms_status": {"enum": ["ORIGINAL_SYNTHETIC", "REVIEWED_ALLOWED", "UNREVIEWED_LOCAL_ONLY", "BLOCKED"]}}},
    "data_origin": {"enum": ["SYNTHETIC_ONLY", "HISTORICAL_PUBLIC_DATA", "AUTHORIZED_PRIVATE_DATA"]},
    "scenario_origin": {"enum": ["SYNTHETIC_ASSUMPTION", "MEASURED_PARAMETERS", "NONE"]},
    "policy_id": {"type": "string", "minLength": 1},
    "seed": {"type": "integer", "minimum": 0},
    "budget_units": {"type": "number", "exclusiveMinimum": 0},
    "batch_size": {"type": "integer", "minimum": 1},
    "initial_label_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "initial_labels_budget_rule": {"enum": ["PREEXISTING_SUNK_COST", "CHARGED_EQUALLY"]},
    "algorithm_status": {"enum": ["BASELINE_IMPLEMENTED", "BANDIT_TRAINED", "RL_TRAINED", "PLANNED", "NOT_RUN"]},
    "digital_twin_maturity": {"enum": ["RETROSPECTIVE_SIMULATOR", "CALIBRATED_SIMULATOR", "DIGITAL_SHADOW", "VALIDATED_DIGITAL_TWIN"]},
    "cost_note": {"type": "string"},
    "delay_note": {"type": "string"},
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
